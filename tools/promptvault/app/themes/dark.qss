/* Dark theme — PromptVault */

/* ==== Base ==== */
QWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    selection-background-color: #094771;
    selection-color: #ffffff;
    font-size: 10pt;
}

QMainWindow {
    background-color: #1e1e1e;
}

/* ==== Buttons ==== */
QPushButton {
    background-color: #2d2d30;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 5px;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: #3c3c3c;
}

QPushButton:pressed {
    background-color: #4fc3f7;
    color: #0d1117;
}

QPushButton:disabled {
    background-color: #252526;
    color: #9da5b4;
    border: 1px solid #252526;
}

QPushButton#primaryButton {
    background-color: #4fc3f7;
    color: #0d1117;
    border: 1px solid #4fc3f7;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #29b6f6;
    border: 1px solid #29b6f6;
}

QPushButton#primaryButton:pressed {
    background-color: #29b6f6;
}

/* ==== Inputs ==== */
QLineEdit, QTextEdit {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 5px;
    padding: 4px 6px;
    selection-background-color: #094771;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #4fc3f7;
}

/* ==== Lists ==== */
QListWidget {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    outline: none;
}

QListWidget::item {
    padding: 6px;
    border-radius: 4px;
    color: #e0e0e0;
}

QListWidget::item:hover {
    background-color: #2d2d30;
}

QListWidget::item:selected {
    background-color: #094771;
    color: #ffffff;
}

/* ==== ScrollArea ==== */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ==== ScrollBar ==== */
QScrollBar:vertical {
    background: #252526;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #4a4a4a;
    min-height: 24px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #5a5a5a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #252526;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #4a4a4a;
    min-width: 24px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #5a5a5a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==== CheckBox / RadioButton ==== */
QCheckBox, QRadioButton {
    color: #e0e0e0;
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3c3c3c;
    background-color: #2d2d2d;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #4fc3f7;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #4fc3f7;
    border: 1px solid #4fc3f7;
}

/* исключающий фильтр (задача: трёхстанный фильтр LoRA/тегов —
   включить/исключить/нейтрально, см. app/ui/filter_popup.py) —
   переиспользуем состояние PartiallyChecked обычного QCheckBox как
   "исключить", подсвечиваем красным вместо обычного акцентного цвета */
QCheckBox::indicator:indeterminate {
    background-color: #e74c3c;
    border: 1px solid #e74c3c;
}

QCheckBox:indeterminate {
    color: #e74c3c;
}

/* ==== ComboBox ==== */
QComboBox {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 5px;
    padding: 4px 8px;
}

QComboBox:hover {
    border: 1px solid #4fc3f7;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    selection-background-color: #094771;
    selection-color: #ffffff;
    outline: none;
}

/* ==== Labels ==== */
QLabel {
    color: #e0e0e0;
    background-color: transparent;
}

/* ==== Popups (Filters / Sort) ==== */
QFrame#filterPopup, QFrame#sortPopup {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
}

/* ==== Splitter ==== */
QSplitter::handle {
    background-color: #3c3c3c;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ==== ToolTips ==== */
QToolTip {
    background-color: #2d2d30;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    padding: 4px;
}

/* ==== Избранное / рейтинг ==== */
QPushButton#favoriteButton {
    background-color: transparent;
    border: none;
    color: #9da5b4;
    padding: 2px 4px;
    text-align: left;
    font-weight: 600;
}

QPushButton#favoriteButton:hover {
    color: #4fc3f7;
    background-color: transparent;
}

QLabel#ratingStar {
    font-size: 13pt;
    padding: 0px 1px;
    color: #9da5b4;
}

QLabel#ratingStar[filled="true"] {
    color: #4fc3f7;
}

/* ==== Выделенная карточка генерации ==== */
QWidget#generationCard {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}

QWidget#generationCard[selected="true"] {
    background-color: #094771;
    border: 1px solid #4fc3f7;
}
