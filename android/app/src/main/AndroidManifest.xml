<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Discovery (NsdManager) + сам HTTP/WS-трафик к Remote API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- CHANGE_WIFI_MULTICAST_STATE — на части устройств mDNS-пакеты
         (multicast) без него не доходят при агрессивном сне Wi-Fi;
         NsdManager сам берёт мультикаст-лок под капотом на большинстве
         прошивок, но разрешение всё равно требуется декларативно. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- §Этап 6.5 — без него на API 33+ notify() в FcmService.kt
         молча ничего не показывает, даже если система разрешение уже
         как бы "дала" по умолчанию для старых приложений: начиная с
         API 33 это ОБЯЗАН быть runtime-запрос (см. MainActivity.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Автосохранение сгенерированных картинок (GeneratedImageSaver.kt)
         — нужно ТОЛЬКО на API 26-28: начиная с API 29 (Scoped Storage)
         запись в MediaStore для собственных файлов приложения не
         требует этого разрешения вовсе, поэтому maxSdkVersion="28" —
         на более новых устройствах система даже не покажет это
         разрешение в списке запрашиваемых. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- §Этап 9 — WireGuard-туннель (com.wireguard.android:tunnel).
         Само согласие пользователя на VPN — не манифест-разрешение, а
         системный диалог через GoBackend.VpnService.prepare(context) +
         startActivityForResult (runtime-флоу, см. TunnelManager.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="false"
        android:label="ComfyUI Studio"
        android:theme="@style/Theme.ComfyUIStudioTerminal"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic — Remote API этапа 6 обслуживает
             только голый http:// в пределах LAN (см. proxy_auth.py на
             сервере, docstring про Secure-куки и §9 дорожной карты про
             VPN как отдельный будущий слой) — без этого флага система
             с API 28+ молча блокирует все запросы к http://<lan-ip>. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="ComfyUI Studio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".terminal.TerminalActivity"
            android:exported="false"
            android:label="ComfyUI Studio"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- §Этап 6.5 — FirebaseMessagingService. exported=false: этот
             сервис вызывается только самим Firebase SDK изнутри
             процесса приложения, никогда напрямую системой/другими
             приложениями. Работает и без google-services.json (см.
             app/build.gradle.kts) — просто никогда не получит
             реального токена/сообщения, декларация в манифесте от
             этого не становится некорректной. -->
        <service
            android:name=".fcm.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- §Этап 9 — сам системный VpnService из библиотеки
             com.wireguard.android:tunnel (не наш класс, мы его только
             декларируем) — без этой записи GoBackend.VpnService.
             prepare()/setState(UP, ...) падает в рантайме, т.к. система
             не находит зарегистрированный VPN-сервис. permission +
             intent-filter — стандартная декларация для ЛЮБОГО
             VpnService в Android, не специфика именно этой библиотеки. -->
        <service
            android:name="com.wireguard.android.backend.GoBackend$VpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <activity
            android:name=".tunnel.TunnelSettingsActivity"
            android:exported="false"
            android:label="Доступ вне дома (VPN)" />
    </application>
</manifest>
