/* GitHub Dark theme — PromptVault */

/* ==== Base ==== */
QWidget {
    background-color: #0d1117;
    color: #c9d1d9;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
    font-size: 10pt;
}

QMainWindow {
    background-color: #0d1117;
}

/* ==== Buttons ==== */
QPushButton {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: #30363d;
}

QPushButton:pressed {
    background-color: #58a6ff;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #161b22;
    color: #8b949e;
    border: 1px solid #161b22;
}

QPushButton#primaryButton {
    background-color: #58a6ff;
    color: #ffffff;
    border: 1px solid #58a6ff;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #1f6feb;
    border: 1px solid #1f6feb;
}

QPushButton#primaryButton:pressed {
    background-color: #1f6feb;
}

/* ==== Inputs ==== */
QLineEdit, QTextEdit {
    background-color: #0d1117;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 4px 6px;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #58a6ff;
}

/* ==== Lists ==== */
QListWidget {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    outline: none;
}

QListWidget::item {
    padding: 6px;
    border-radius: 4px;
    color: #c9d1d9;
}

QListWidget::item:hover {
    background-color: #21262d;
}

QListWidget::item:selected {
    background-color: #1f6feb;
    color: #ffffff;
}

/* ==== ScrollArea ==== */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ==== ScrollBar ==== */
QScrollBar:vertical {
    background: #161b22;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #30363d;
    min-height: 24px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #484f58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #161b22;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #30363d;
    min-width: 24px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #484f58;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==== CheckBox / RadioButton ==== */
QCheckBox, QRadioButton {
    color: #c9d1d9;
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #30363d;
    background-color: #0d1117;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #58a6ff;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #58a6ff;
    border: 1px solid #58a6ff;
}

/* исключающий фильтр (задача: трёхстанный фильтр LoRA/тегов —
   включить/исключить/нейтрально, см. app/ui/filter_popup.py) —
   переиспользуем состояние PartiallyChecked обычного QCheckBox как
   "исключить", подсвечиваем красным вместо обычного акцентного цвета */
QCheckBox::indicator:indeterminate {
    background-color: #e74c3c;
    border: 1px solid #e74c3c;
}

QCheckBox:indeterminate {
    color: #e74c3c;
}

/* ==== ComboBox ==== */
QComboBox {
    background-color: #0d1117;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 4px 8px;
}

QComboBox:hover {
    border: 1px solid #58a6ff;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    color: #c9d1d9;
    border: 1px solid #30363d;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
    outline: none;
}

/* ==== Labels ==== */
QLabel {
    color: #c9d1d9;
    background-color: transparent;
}

/* ==== Popups (Filters / Sort) ==== */
QFrame#filterPopup, QFrame#sortPopup {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
}

/* ==== Splitter ==== */
QSplitter::handle {
    background-color: #30363d;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ==== ToolTips ==== */
QToolTip {
    background-color: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    padding: 4px;
}

/* ==== Избранное / рейтинг ==== */
QPushButton#favoriteButton {
    background-color: transparent;
    border: none;
    color: #8b949e;
    padding: 2px 4px;
    text-align: left;
    font-weight: 600;
}

QPushButton#favoriteButton:hover {
    color: #58a6ff;
    background-color: transparent;
}

QLabel#ratingStar {
    font-size: 13pt;
    padding: 0px 1px;
    color: #8b949e;
}

QLabel#ratingStar[filled="true"] {
    color: #58a6ff;
}

/* ==== Выделенная карточка генерации ==== */
QWidget#generationCard {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
}

QWidget#generationCard[selected="true"] {
    background-color: #1f6feb;
    border: 1px solid #58a6ff;
}


/* ==== Дополнено для ComfyUI Launcher: QGroupBox/QProgressBar/QSpinBox/QMenu ==== */
QGroupBox {
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #58a6ff;
}

QProgressBar {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    text-align: center;
    color: #c9d1d9;
}

QProgressBar::chunk {
    background-color: #58a6ff;
    border-radius: 6px;
}

QSpinBox {
    background-color: #161b22;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 3px 6px;
}

QSpinBox:hover {
    border: 1px solid #58a6ff;
}

QMenu {
    background-color: #161b22;
    color: #c9d1d9;
    border: 1px solid #30363d;
}

QMenu::item {
    padding: 5px 20px;
}

QMenu::item:selected {
    background-color: #58a6ff;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #30363d;
    margin: 4px 6px;
}
