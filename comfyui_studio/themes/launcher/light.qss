/* ==== Дополнено для ComfyUI Launcher: QGroupBox/QProgressBar/QSpinBox/QMenu ==== */
QGroupBox {
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #1976d2;
}

QProgressBar {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    text-align: center;
    color: #1e1e1e;
}

QProgressBar::chunk {
    background-color: #1976d2;
    border-radius: 6px;
}

QSpinBox {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
    border-radius: 5px;
    padding: 3px 6px;
}

QSpinBox:hover {
    border: 1px solid #1976d2;
}

QMenu {
    background-color: #ffffff;
    color: #1e1e1e;
    border: 1px solid #d0d0d0;
}

QMenu::item {
    padding: 5px 20px;
}

QMenu::item:selected {
    background-color: #1976d2;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #d0d0d0;
    margin: 4px 6px;
}
