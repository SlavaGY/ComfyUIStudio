/* ==== Дополнено для ComfyUI Launcher: QGroupBox/QProgressBar/QSpinBox/QMenu ==== */
QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #4fc3f7;
}

QProgressBar {
    background-color: #2d2d2d;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    text-align: center;
    color: #e0e0e0;
}

QProgressBar::chunk {
    background-color: #4fc3f7;
    border-radius: 6px;
}

QSpinBox {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 5px;
    padding: 3px 6px;
}

QSpinBox:hover {
    border: 1px solid #4fc3f7;
}

QMenu {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
}

QMenu::item {
    padding: 5px 20px;
}

QMenu::item:selected {
    background-color: #4fc3f7;
    color: #0d1117;
}

QMenu::separator {
    height: 1px;
    background: #3c3c3c;
    margin: 4px 6px;
}
