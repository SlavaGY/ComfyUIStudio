/* ==== Дополнено для ComfyUI Launcher: QGroupBox/QProgressBar/QSpinBox/QMenu ==== */
QGroupBox {
    border: 1px solid #4C566A;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #88C0D0;
}

QProgressBar {
    background-color: #3B4252;
    border: 1px solid #4C566A;
    border-radius: 6px;
    text-align: center;
    color: #ECEFF4;
}

QProgressBar::chunk {
    background-color: #88C0D0;
    border-radius: 6px;
}

QSpinBox {
    background-color: #3B4252;
    color: #ECEFF4;
    border: 1px solid #4C566A;
    border-radius: 5px;
    padding: 3px 6px;
}

QSpinBox:hover {
    border: 1px solid #88C0D0;
}

QMenu {
    background-color: #3B4252;
    color: #ECEFF4;
    border: 1px solid #4C566A;
}

QMenu::item {
    padding: 5px 20px;
}

QMenu::item:selected {
    background-color: #88C0D0;
    color: #2E3440;
}

QMenu::separator {
    height: 1px;
    background: #4C566A;
    margin: 4px 6px;
}
